{
  "name": "db-tools",
  "version": "1.3.0-beta.1",
  "description": "DB Tools \u2013 Folien-Zuschnittplaner f\u00fcr macOS",
  "author": "DB SOLUTION",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/icons.cjs",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "dist": "node scripts/build.cjs",
    "release": "node scripts/build.cjs",
    "appcast": "node scripts/appcast.cjs"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "ch.dbsolution.dbtools",
    "productName": "DB Tools",
    "copyright": "DB SOLUTION",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "DB-Tools-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "DB Tools installieren",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 680,
        "height": 440
      },
      "contents": [
        {
          "x": 175,
          "y": 220,
          "type": "file"
        },
        {
          "x": 505,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UniverseMan12/DB_Tools.git"
  },
  "dependencies": {
    "electron-sparkle": "0.2.0"
  }
}
